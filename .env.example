# Copy to .env and adjust. Auth uses gcloud Application Default Credentials:
#   gcloud auth application-default login
VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_REGION=global
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=600
AGENT_MAX_TURNS=5

# USD per million tokens, used for cost figures
PRICE_INPUT_PER_MTOK=3.0
PRICE_OUTPUT_PER_MTOK=15.0

# System One (Laya)
SYSTEM_ONE_STRATEGY=hybrid        # hybrid | tournament | shortlist
SYSTEM_ONE_TOP_K=6
DIRECT_ANSWER_THRESHOLD=0.70
# LAYA_DEVICE=cpu                 # default: auto (MPS on Apple Silicon)
# LAYA_MODEL_PATH=./models/laya
# EMBED_MODEL_PATH=./models/bge-small-en-v1.5
